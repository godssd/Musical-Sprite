using UnityEngine;

/// <summary>
/// 布姆炸弹的卡通爆炸效果 —— 【1:1 对齐 Stylized Explosion Pack 参考 prefab】
/// 参考体：Assets/EffectCore/packs/StylizedExplosionPack1/prefabs/mobile/red_originalFire_mobile/
///         explosionMobile_stylized_small_originalFire.prefab
///
/// ============================ 参考的真实结构（已逐层扒参） ============================
/// 参考不是"一堆 billboard 圆点"，而是 **Mesh 渲染 + Billboard + Stretch 混搭**：
///
///   ① sphereFlash         Mesh(内置 Sphere) + 无色纯色    → 爆炸扩散球，0→2.8 膨胀后淡出
///   ② flarespikes         Mesh(cone.obj)    + flarespark  → 放射火舌，speed=0，靠 size 0→5 膨胀
///   ③ flarespikes_delayed Mesh(cone.obj)    + flarespark  → 错峰第二波火舌
///   ④ inner_fire          Billboard         + fire.psd    → 焰心，size 1→0 收缩，白→金黄→橙→深红
///   ⑤ fire_floaters       Stretch           + fire.psd    → 上浮火苗，gravity 为负
///   ⑥ firey_debris        Mesh(scrap.obj)   + 亮色        → 碎片，gravity 正，抛物线落地
///   ⑦ circle              Mesh(quad4point)  + circle.psd  → 贴地扩散环，size 25
///   ⑧ circularSmoke       Billboard         + smoke_d.psd → 环形烟（AlphaBlend）
///   ⑨ smokeUp             Billboard         + smoke_d.psd → 向上喷发的烟柱（AlphaBlend）
///   ⑩ smoke               Billboard         + smoke_d.psd → 近地余烟（AlphaBlend）
///   ⑪ decal_heatedStrike  HorizBillboard    + explodedecal→ 地面焦痕（随机旋转，AlphaBlend）
///   ⑫ decal               HorizBillboard    + explodedecal→ 大焦痕（AlphaBlend）
///
///
/// 【第三轮：补齐参考里此前完全漏掉的 4 个模块（★烟尘手感的关键）】
///   ⛔⛔ 教训：只对齐 Initial/Shape/Emission/Size/Color 五个模块是不够的，
///       参考还开了 ClampVelocity / UV(序列帧) / Rotation / Collision，缺一个手感就全不对。
///   g) **ClampVelocityModule → limitVelocityOverLifetime**（inner_fire / floaters / debris /
///      circularSmoke / smokeUp / smoke 六层都开了）。
///      这才是「高初速爆出 → 被阻尼拉回低速 → 靠负重力缓缓上飘」的来源：
///      circularSmoke 初速 15，但 limit 被钳到随机 0.5~1.2、dampen 0.4。
///      缺了它，烟会一直高速直线飘，完全没有"炸开后收住"的节奏。
///   h) **UVModule → textureSheetAnimation**（inner_fire / fire_floaters 开了）。
///      ⛔ fire.psd 其实是 **2×2 精灵图（4 个火焰变体）**，参考每颗粒子随机取一格；
///      我们之前整张 4 格一起贴 ⇒ 火焰等于大了 2 倍且糊成一团。
///      （smoke_d.psd 不是序列帧，烟层没开这个模块。）
///   i) **RotationModule → rotationOverLifetime**（6 层都开了，仅 Z 轴随机自转，弧度/秒）。
///      让每团烟/每簇火朝向各不相同，避免"复制粘贴"感。
///   j) **CollisionModule**（仅 firey_debris 开了）：bounce=1（全弹）、能量损失 0.5
///      ⇒ 碎片落地会弹跳。⚠ 需要场景里有地面碰撞体，沙盒没地面则不弹（无害）。
///   k) 仍未照搬：firey_debris 的 SubModule 会把 smoke 作为 Birth 子发射（每个碎片带 1 团淡烟），
///      我们保留独立的 smoke burst=8（更明显），属有意偏离。
///
/// ⛔ 五个历史踩坑（别再犯）：
///   1. 参考的**烟是 AlphaBlend**，不是 Additive。用加法会把烟做成发亮的大黄云。
///   2. 参考的**颜色全在 colorOverLifetime 梯度里**，startColor 基本是白/灰。
///      URP 若把 _ColorMode 设成 Additive(1) 会忽略顶点色 → 梯度失效 → 爆炸发灰。
///   3. 参考的火舌层 **startSpeed = 0**，是靠 size 从 0 膨胀形成"向外辐射"，不是靠速度飞出去。
///   4. ⛔⛔ **喷射朝向**：下面这些层的 Transform 在参考里都带 **绕 X 轴 −90°** 的旋转——
///        sphereFlash / inner_fire / fire_floaters / circularSmoke / smokeUp / smoke / firey_debris
///      它把 Cone/Sphere 的喷射主轴从 +Y 掰到 **−Z**（参考 demo 的相机正位于 −Z 侧，
///      所以屏幕上看到的就是"爆向镜头、由内向外放射"）。
///      而 flarespikes / flarespikes_delayed / circle / decal* 保持 identity（主轴仍 +Y）。
///      漏掉这个 −90° ⇒ 烟/火/碎屑全部朝天，俯视锁视角下彻底失去放射感
///      ⇒ 这就是"烟尘运动错误很严重"的根因。
///      现用 aimMode 控制：0=照搬参考(−90°，主轴恒向世界 −Z)
///                        1=每轮爆炸前动态对准主相机（默认推荐，任何视角下都是"由内向外"）
///                        2=自定义欧拉角
///
/// 【第二轮逐参数筛查修正（对比参考 prefab 原始 YAML）】
///   a) Shape 半径全照搬：参考几乎所有层的出生点半径都只有 **0.01**（几乎就是一个点），
///      只有 circularSmoke=0.48（这才是"环形烟"的由来）、inner_fire=0.1、floaters=0.61。
///      之前自作主张放大到 0.25~0.5 ⇒ 粒子从一个大球面起跳 ⇒ 画面糊成一团、看不出从中心炸开。
///   b) circle（扩散环）startColor 的 alpha 参考是 **0.282**（加法 shader 里 alpha 会乘进 rgb）
///      ⇒ 之前用 1.0，环过亮过实。
///   c) decal（大焦痕）startColor 参考是 **黑 RGB + alpha 0.541**
///      ⇒ 之前用白色，焦痕发白；改黑后才对（焦痕本来就该是烧黑的）。
///   d) 每层有自己的 localPosition（y 从 −0.09 到 0.68、多数 z=+0.18），不再统一抬高。
///   e) fire_floaters 补上参考开启的 Noise（frequency 0.5 / damping / octaves 1）。
///   f) smokeUp 参考的 localPosition 是 (−2.78, 0.13, −2.04)，烟柱会跑到爆点外很远，
///      疑似 prefab 残留 ⇒ 默认归零并留出 smokeUpExtraOffset，想照搬原值填进去即可。
///
/// 【素材】默认槽位为空 → 运行时程序化兜底；在沙盒里由 VFXSandboxBuilder 自动填入参考包素材。
///   最终替换成自绘贴图/模型时，只需改这几个字段的引用，参数一行不动。
/// ⛔ 所有 GameObject / Material / Texture / Mesh 运行时创建且 HideFlags.DontSave，绝不污染场景。
/// </summary>
public class BombExplosion : MonoBehaviour
{
    // ====================================================================
    // 素材槽（留空 = 程序化兜底）
    // ====================================================================
    [Header("素材槽 · 贴图（留空则程序化兜底）")]
    [Tooltip("参考：packs/StylizedExplosionPack1/textures/fire.psd")]
    public Texture2D texFire;
    [Tooltip("参考：packs/StylizedExplosionPack1/textures/smoke_d.psd")]
    public Texture2D texSmoke;
    [Tooltip("参考：packs/StylizedExplosionPack1/textures/circle.psd")]
    public Texture2D texCircle;
    [Tooltip("参考：packs/StylizedExplosionPack1/textures/flarespark.psd")]
    public Texture2D texFlareSpark;
    [Tooltip("参考：packs/StylizedExplosionPack1/textures/explodedecal.psd")]
    public Texture2D texDecal;

    [Header("素材槽 · 模型（留空则程序化兜底）")]
    [Tooltip("参考：Assets/EffectCore/models/cone.obj（导入 globalScale=0.01，底在 y=0、尖朝 +Y、高 0.37）")]
    public Mesh meshCone;
    [Tooltip("参考：Assets/EffectCore/models/quad4point.obj（导入 globalScale=0.001，XZ 平面水平四边形）")]
    public Mesh meshQuad4Point;
    [Tooltip("参考：Assets/EffectCore/models/scrap.obj（不规则碎片）")]
    public Mesh meshScrap;

    // ====================================================================
    // 全局
    // ====================================================================
    [Header("全局")]
    [Tooltip("HDR 亮度倍数。参考净效果 = 内置 Additive 的 2.0 × _TintColor 0.5 = 1.0，故默认 1.0")]
    public float hdrIntensity = 1.0f;
    [Tooltip("整体额外抬高（加在参考各层原有高度之上）。0 = 完全照搬参考；地面不平时可适当加一点")]
    public float explodeHeight = 0f;
    [Tooltip("整体缩放。1=与参考同尺寸")]
    public float globalScale = 1.0f;

    // ====================================================================
    // 喷射朝向 —— 决定烟/火/碎屑「往哪飞」
    // ====================================================================
    [Header("喷射朝向（烟尘/火焰的运动方向）")]
    [Tooltip("0 = 照搬参考（★俯视默认）：受影响层一律绕 X 轴 −90°，喷射主轴恒指向世界 −Z。\n" +
             "    俯视锁视角下，−Z 是水平方向，烟/火会贴着地面向四周扩散，再靠负重力缓缓上升——这正是参考的扩散→上升→消散节奏。\n" +
             "1 = 动态对准主相机：每轮爆炸前把喷射主轴转向主相机。侧视/过场动画可用；俯视相机在头顶时会把烟柱朝天喷，出现截图里那种「烟云堆在爆点上方」的问题。\n" +
             "2 = 自定义欧拉角（填在 aimEulerOverride）。")]
    public int aimMode = 0;
    [Tooltip("aimMode=2 时使用的欧拉角")]
    public Vector3 aimEulerOverride = new Vector3(-90f, 0f, 0f);
    [Tooltip("受朝向瞄准影响的层：sphereFlash / inner_fire / fire_floaters / circularSmoke / smokeUp / smoke / firey_debris。\n" +
             "（flarespikes、circle、decal 在参考里没有这个旋转，永远不受瞄准影响）")]
    public bool enableAim = true;
    [Tooltip("Mesh 渲染层的朝向模式。Local = 粒子保持自身朝向（★默认，火舌才有放射感）；\n" +
             "View = 粒子一律面向相机。参考 prefab 是 Unity5 老格式、没有这个字段，若火舌观感不对可切到 View 对比。")]
    public ParticleSystemRenderSpace meshAlignment = ParticleSystemRenderSpace.Local;
    [Tooltip("smokeUp 的额外偏移。参考 prefab 原值是 (−2.78, 0, −2.04)，会让烟柱跑到爆点外很远（疑似残留），默认归零。")]
    public Vector3 smokeUpExtraOffset = Vector3.zero;

    // ====================================================================
    // 补齐参考里此前漏掉的模块（★烟尘运动手感的关键，全部可一键关闭回退）
    // ====================================================================
    [Header("参考遗漏模块（可整体关闭回退）")]
    [Tooltip("★速度钳制+阻尼。烟/火高速爆出后被拉回低速，形成「快出→减速→缓缓上飘→缩小消失」的节奏。\n" +
             "参考 = ClampVelocityModule，Unity6 里对应 limitVelocityOverLifetime。关掉=回到之前\"一直高速飘\"的错误手感。")]
    public bool enableClampVelocity = true;
    [Tooltip("★序列帧动画。fire.psd 其实是 2×2 精灵图（4 个火焰变体），参考每层火焰随机取其中一格。\n" +
             "之前我们整张 4 格一起贴，火焰等于大了 2 倍且糊成一团。关掉=回到整图显示。")]
    public bool enableSheetAnimation = true;
    [Tooltip("生命周期内随机自转，让每团烟/每簇火的朝向各不相同，避免\"复制粘贴\"感。参考 = RotationModule。")]
    public bool enableRotOverLife = true;
    [Tooltip("碎片落地碰撞弹跳。参考 firey_debris 开了碰撞：bounce=1（全弹）、能量损失 0.5。\n" +
             "⚠ 需要场景里有地面碰撞体才生效；沙盒没地面则不弹（无害）。")]
    public bool enableDebrisCollision = true;

    // ====================================================================
    // ① 爆炸扩散球 sphereFlash —— Mesh(Sphere)，无色纯色
    // ====================================================================
    [Header("① 扩散球 sphereFlash（Mesh 球体）")]
    public bool enableSphereFlash = true;
    public float sphereFlashSize = 2.8f;
    public float sphereFlashLifetime = 0.28f;

    // ====================================================================
    // ② 放射火舌 flarespikes —— Mesh(cone)，speed=0，size 0→5
    // ====================================================================
    [Header("② 放射火舌 flarespikes（Mesh 锥体）")]
    public bool enableSpikes = true;
    public float spikeSize = 5.0f;
    public float spikeLifetime = 0.30f;
    public int spikeCount = 2;
    [Tooltip("火舌起点距中心的距离（Sphere shape 半径）。参考原值 0.01 —— 几乎从同一个点炸出，这才是放射感的来源")]
    public float spikeRadius = 0.01f;

    // ====================================================================
    // ③ 错峰火舌 flarespikes_delayed
    // ====================================================================
    [Header("③ 错峰火舌 flarespikes_delayed")]
    public bool enableDelayedSpikes = true;
    public float delayedSpikeSize = 6.0f;
    public float delayedSpikeLifetime = 0.20f;
    public int delayedSpikeCount = 2;
    public float delayedSpikeDelay = 0.05f;
    [Tooltip("参考原值 0.01")]
    public float delayedSpikeRadius = 0.01f;

    // ====================================================================
    // ④ 焰心 inner_fire —— Billboard + fire.psd，Cone 13.18°，size 1→0
    // ====================================================================
    [Header("④ 焰心 inner_fire（Billboard）")]
    public bool enableInnerFire = true;
    public float innerFireSizeMin = 0.6f, innerFireSizeMax = 1.4f;
    public float innerFireLifeMin = 0.1f, innerFireLifeMax = 0.4f;
    public float innerFireSpeedMin = 11.32f, innerFireSpeedMax = 12.4f;
    public float innerFireGravity = 1.0f;
    public float innerFireConeAngle = 13.18f;
    [Tooltip("焰心 Cone 出生点半径。参考原值 0.1（之前误用 0.5，焰心糊成一团）")]
    public float innerFireConeRadius = 0.1f;

    // ====================================================================
    // ⑤ 上浮火苗 fire_floaters —— Stretch + fire.psd
    // ====================================================================
    [Header("⑤ 上浮火苗 fire_floaters（Stretch）")]
    public bool enableFloaters = true;
    public float floaterSize = 0.04f;
    public float floaterLifeMin = 0.1f, floaterLifeMax = 1.0f;
    public float floaterSpeedMin = 2.0f, floaterSpeedMax = 3.0f;
    public float floaterGravityMin = -0.5f, floaterGravityMax = -0.1f;
    public float floaterVelocityScale = 0.1f;
    public float floaterLengthScale = 2.0f;
    [Tooltip("火苗出生所用的 Hemisphere 半径。参考原值 0.61（注：参考这里用的是 Hemisphere，不是 Cone）")]
    public float floaterShapeRadius = 0.61f;
    [Tooltip("Hemisphere 的角度。参考原值 12.9")]
    public float floaterShapeAngle = 12.9f;
    [Tooltip("参考给火苗开了 Noise，让上浮轨迹有自然抖动")]
    public bool floaterNoise = true;
    public float floaterNoiseStrength = 1.0f;
    public float floaterNoiseFrequency = 0.5f;

    // ====================================================================
    // ⑥ 火焰碎片 firey_debris —— Mesh(scrap)，Cone 39°，gravity 正
    // ====================================================================
    [Header("⑥ 火焰碎片 firey_debris（Mesh 碎片）")]
    public bool enableDebris = true;
    public float debrisSizeMin = 0.7f, debrisSizeMax = 1.4f;
    public float debrisLifeMin = 0.4f, debrisLifeMax = 0.8f;
    public float debrisSpeedMin = 15.0f, debrisSpeedMax = 19.0f;
    public float debrisGravityMin = 0.3f, debrisGravityMax = 2.5f;
    public float debrisConeAngle = 39.03f;
    [Tooltip("碎片 Cone 出生点半径。参考原值 0.01（之前误用 0.3，碎片像从一个大球壳里冒出来）")]
    public float debrisConeRadius = 0.01f;
    public int debrisCount = 3;

    // ====================================================================
    // ⑦ 贴地扩散环 circle —— Mesh(quad4point) + circle.psd
    // ====================================================================
    [Header("⑦ 扩散环 circle（Mesh 水平四边形）")]
    public bool enableRing = true;
    public float ringSize = 25.0f;
    public float ringLifetime = 0.40f;
    [Tooltip("若扩散环过大盖住场地，调小此值（参考原值 25）")]
    public float ringSizeScale = 1.0f;

    // ====================================================================
    // ⑧ 环形烟 circularSmoke —— Billboard + smoke_d.psd，AlphaBlend
    // ====================================================================
    [Header("⑧ 环形烟 circularSmoke（Alpha 混合）")]
    public bool enableCircleSmoke = true;
    public float circleSmokeSizeMin = 0.4f, circleSmokeSizeMax = 0.9f;
    public float circleSmokeLifeMin = 0.6f, circleSmokeLifeMax = 2.0f;
    public float circleSmokeSpeedMin = 7.0f, circleSmokeSpeedMax = 15.0f;
    public float circleSmokeGravity = -0.1f;
    public float circleSmokeConeAngle = 74.49f;
    [Tooltip("环形烟 Cone 出生点半径。参考原值 0.48 —— 这是全套里唯一较大的出生半径，\"环形烟\"由此而来")]
    public float circleSmokeConeRadius = 0.48f;
    public int circleSmokeCount = 15;

    // ====================================================================
    // ⑨ 上喷烟柱 smokeUp —— Billboard + smoke_d.psd，AlphaBlend
    // ====================================================================
    [Header("⑨ 上喷烟柱 smokeUp（Alpha 混合）")]
    public bool enableSmokeUp = true;
    public float smokeUpSizeMin = 1.3f, smokeUpSizeMax = 1.8f;
    public float smokeUpLifeMin = 1.4f, smokeUpLifeMax = 1.7f;
    public float smokeUpSpeedMin = 22.0f, smokeUpSpeedMax = 25.0f;
    public float smokeUpGravityMin = -0.6f, smokeUpGravityMax = -0.2f;
    public float smokeUpConeAngle = 21.6f;
    [Tooltip("烟柱 Cone 出生点半径。参考原值 0.01（之前误用 0.5，烟柱东一块西一块，不成\"柱\"）")]
    public float smokeUpConeRadius = 0.01f;
    public int smokeUpCount = 15;

    // ====================================================================
    // ⑩ 近地余烟 smoke —— Billboard + smoke_d.psd，AlphaBlend
    //     参考该层 burst=0（靠父物体驱动），此处给一个小 burst 让它可见
    // ====================================================================
    [Header("⑩ 近地余烟 smoke（Alpha 混合）")]
    public bool enableSmoke = true;
    public float smokeSize = 0.6f;
    public float smokeLifeMin = 0.4f, smokeLifeMax = 0.5f;
    public float smokeSpeedMin = 0.13f, smokeSpeedMax = 0.92f;
    public float smokeGravityMin = 0.1f, smokeGravityMax = 0.5f;
    [Tooltip("余烟 Sphere 出生点半径。参考原值 0.01（之前误用 0.4，余烟像从一个大气球里冒出来）")]
    public float smokeRadius = 0.01f;
    public int smokeCount = 8;
    public float smokeDelay = 0.08f;

    // ====================================================================
    // ⑪⑫ 地面焦痕 decal —— HorizBillboard + explodedecal.psd，AlphaBlend，随机旋转
    // ====================================================================
    [Header("⑪⑫ 地面焦痕 decal（随机角度 · Alpha 混合）")]
    public bool enableDecal = true;
    public float decalHeatedSize = 0.6f;
    public float decalHeatedLifetime = 2.5f;
    public float decalSize = 1.8f;
    public float decalLifetime = 3.0f;

    // ====================================================================
    // 爆炸闪光（参考有 light_fireexplosion 点光源）
    // ====================================================================
    [Header("爆炸闪光（点光源）")]
    public bool enableLight = true;
    public Color lightColor = new Color(1f, 0.55f, 0.2f, 1f);
    public float lightIntensity = 8f;
    public float lightRange = 14f;
    public float lightDuration = 0.5f;

    [Header("循环（沙盒预览用）")]
    [Tooltip("开启后持续循环爆炸，便于在沙盒里反复观察（进游戏用单次 Explode/ExplodeAt 即可）")]
    public bool loop = false;
    [Tooltip("每轮爆炸间隔（秒）。参考整套最长 3s（decal），建议 ≥3s 让一轮跑完")]
    public float loopInterval = 3.0f;

    // ---------------- 运行时资源 ----------------
    private Texture2D _genFire, _genSmoke, _genCircle, _genFlare, _genDecal;
    private Mesh _genCone, _genQuad, _genScrap, _genSphere;
    private Material _matFire, _matFlare, _matRing, _matSmoke, _matDecal, _matPlain;
    private Light _light;
    private float _lightT = -1f;
    private float _loopTimer = 0f;
    private bool _built;

    // 各层粒子系统
    private ParticleSystem[] _all;
    /// <summary>需要按 aimMode 调整喷射主轴的层（参考里带 Rx(−90°) 的那几个）。</summary>
    private readonly System.Collections.Generic.List<Transform> _aimTargets =
        new System.Collections.Generic.List<Transform>();

    void OnEnable()
    {
        if (Application.isPlaying)
        {
            Build();
            if (loop) _loopTimer = 0f;
        }
    }

    void OnDisable()
    {
        DestroyRuntime(ref _matFire); DestroyRuntime(ref _matFlare);
        DestroyRuntime(ref _matRing); DestroyRuntime(ref _matSmoke);
        DestroyRuntime(ref _matDecal); DestroyRuntime(ref _matPlain);
        DestroyRuntime(ref _genFire); DestroyRuntime(ref _genSmoke);
        DestroyRuntime(ref _genCircle); DestroyRuntime(ref _genFlare);
        DestroyRuntime(ref _genDecal);
        DestroyRuntime(ref _genCone); DestroyRuntime(ref _genQuad);
        DestroyRuntime(ref _genScrap); DestroyRuntime(ref _genSphere);
        _all = null;
        _aimTargets.Clear();
        _built = false;
    }

    void OnDestroy()
    {
        DestroyRuntime(ref _matFire); DestroyRuntime(ref _matFlare);
        DestroyRuntime(ref _matRing); DestroyRuntime(ref _matSmoke);
        DestroyRuntime(ref _matDecal); DestroyRuntime(ref _matPlain);
        DestroyRuntime(ref _genFire); DestroyRuntime(ref _genSmoke);
        DestroyRuntime(ref _genCircle); DestroyRuntime(ref _genFlare);
        DestroyRuntime(ref _genDecal);
        DestroyRuntime(ref _genCone); DestroyRuntime(ref _genQuad);
        DestroyRuntime(ref _genScrap); DestroyRuntime(ref _genSphere);
        _aimTargets.Clear();
    }

    private static void DestroyRuntime<T>(ref T o) where T : Object
    {
        if (o == null) return;
        if (Application.isPlaying) Destroy(o); else DestroyImmediate(o);
        o = null;
    }

    // ====================================================================
    // 参考包的颜色梯度（逐层照抄 prefab 的 ColorModule）
    // ====================================================================

    static Gradient GradSphereFlash() => Grad(
        (0.00f, 1f, 1f, 1f, 1f), (0.38f, 1f, 0.796f, 0.353f, 1f),
        (0.42f, 1f, 0.796f, 0.353f, 1f), (1.00f, 1f, 0.282f, 0.016f, 0f));

    static Gradient GradSpikes() => Grad(
        (0.00f, 1f, 1f, 1f, 1f), (0.75f, 1f, 0.682f, 0f, 1f), (1.00f, 1f, 0.682f, 0f, 0f));

    static Gradient GradDelayed() => Grad(
        (0.00f, 1f, 1f, 1f, 1f), (0.36f, 1f, 0.831f, 0.282f, 1f),
        (0.53f, 1f, 0.4f, 0.1f, 1f), (0.75f, 1f, 0f, 0f, 0.859f), (0.85f, 1f, 0f, 0f, 0.4f),
        (1.00f, 1f, 0f, 0f, 0f));

    static Gradient GradInnerFire() => Grad(
