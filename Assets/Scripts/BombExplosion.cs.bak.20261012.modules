        (0.48f, 1f, 0.584f, 0f, 1f), (0.74f, 1f, 0.075f, 0f, 1f),
        (1.00f, 0.255f, 0.110f, 0f, 1f));

    static Gradient GradDebris() => Grad(
        (0.00f, 1f, 1f, 1f, 1f), (0.14f, 1f, 0.984f, 0.447f, 1f),
        (0.53f, 1f, 0.514f, 0.404f, 1f), (1.00f, 1f, 0.514f, 0.404f, 1f));

    static Gradient GradRing() => Grad(
        (0.00f, 1f, 1f, 1f, 1f), (0.14f, 1f, 0.839f, 0.310f, 1f),
        (0.61f, 1f, 0.169f, 0.169f, 1f), (1.00f, 1f, 0.169f, 0.169f, 0f));

    static Gradient GradCircleSmoke() => Grad(
        (0.00f, 1f, 0.949f, 0.655f, 1f), (0.05f, 1f, 0.765f, 0f, 1f),
        (0.09f, 1f, 0.435f, 0f, 1f), (0.10f, 0.368f, 0.368f, 0.368f, 1f),
        (1.00f, 0.368f, 0.368f, 0.368f, 1f));

    static Gradient GradSmokeUp() => Grad(
        (0.00f, 1f, 0.961f, 0.624f, 1f), (0.03f, 0.918f, 0.851f, 0.302f, 1f),
        (0.07f, 0.945f, 0.475f, 0.051f, 1f), (0.11f, 0.368f, 0.368f, 0.368f, 1f),
        (1.00f, 0.368f, 0.368f, 0.368f, 1f));

    static Gradient GradSmoke() => Grad(
        (0.00f, 1f, 0.949f, 0.655f, 1f), (0.02f, 1f, 0.765f, 0f, 1f),
        (0.12f, 1f, 0.435f, 0f, 1f), (0.39f, 0.368f, 0.368f, 0.368f, 1f),
        (1.00f, 0.368f, 0.368f, 0.368f, 1f));

    static Gradient GradDecalHeated() => Grad(
        (0.00f, 1f, 1f, 1f, 1f), (0.14f, 1f, 0.760f, 0f, 1f),
        (0.35f, 1f, 0.4f, 0f, 1f), (0.87f, 1f, 0f, 0f, 0.3f), (1.00f, 1f, 0f, 0f, 0f));

    static Gradient GradDecal() => Grad(
        (0.00f, 1f, 1f, 1f, 1f), (0.89f, 1f, 1f, 1f, 1f), (1.00f, 1f, 1f, 1f, 0f));

    // ====================================================================
    // 参考包的 SizeOverLifetime 曲线
    // ====================================================================

    static AnimationCurve C_Grow() => Keys((0f, 0f), (1f, 1f));
    static AnimationCurve C_DelayedSpike() => Keys((0f, 0f), (0.43f, 0.84f), (1f, 1f));
    static AnimationCurve C_InnerFire() => Keys((0f, 1f), (1f, 0f));
    static AnimationCurve C_Floaters() => Keys((0f, 0f), (0.05f, 1f), (0.32f, 0.58f), (1f, 0.17f));
    static AnimationCurve C_Debris() => Keys((0f, 1f), (1f, 0.54f));
    static AnimationCurve C_Ring() => Keys((0f, 0f), (0.16f, 0.59f), (1f, 1f));
    static AnimationCurve C_CircleSmoke() => Keys((0f, 0f), (0.07f, 1f), (1f, 0f));
    static AnimationCurve C_SmokeUp() => Keys((0f, 0f), (0.07f, 1f), (0.76f, 0.56f), (1f, 0f));
    static AnimationCurve C_Smoke() => Keys((0f, 0.49f), (0.12f, 1f), (1f, 0f));
    static AnimationCurve C_DecalHeated() => Keys((0f, 1f), (1f, 0.82f));

    static AnimationCurve Keys(params (float t, float v)[] k)
    {
        var ks = new Keyframe[k.Length];
        for (int i = 0; i < k.Length; i++)
            ks[i] = new Keyframe(k[i].t, k[i].v, 0f, 0f);
        return new AnimationCurve(ks);
    }

    static Gradient Grad(params (float t, float r, float g, float b, float a)[] s)
    {
        var g = new Gradient();
        var ck = new GradientColorKey[s.Length];
        var ak = new GradientAlphaKey[s.Length];
        for (int i = 0; i < s.Length; i++)
        {
            ck[i] = new GradientColorKey(new Color(s[i].r, s[i].g, s[i].b), s[i].t);
            ak[i] = new GradientAlphaKey(s[i].a, s[i].t);
        }
        g.SetKeys(ck, ak);
        return g;
    }

    // ====================================================================
    // 构建
    // ====================================================================

    private void Build()
    {
        if (_built) return;

        var fire = texFire != null ? texFire : (_genFire = MakeFireTexture());
        var smoke = texSmoke != null ? texSmoke : (_genSmoke = MakeSmokeTexture());
        var circle = texCircle != null ? texCircle : (_genCircle = MakeRingTexture());
        var flare = texFlareSpark != null ? texFlareSpark : (_genFlare = MakeFlareTexture());
        var decal = texDecal != null ? texDecal : (_genDecal = MakeDecalTexture());

        // 加法材质：火焰 / 火舌 / 扩散环 / 碎片 / 扩散球
        _matFire = MakeAdditive(fire);
        _matFlare = MakeAdditive(flare);
        _matRing = MakeAdditive(circle);
        _matPlain = MakeAdditive(null);          // 扩散球：无色纯色
        // ⛔ Alpha 材质：烟与焦痕（参考就是 AlphaBlend，用加法会变成发亮的大黄云）
        _matSmoke = MakeAlpha(smoke);
        _matDecal = MakeAlpha(decal);

        var cone = meshCone != null ? meshCone : (_genCone = MakeConeMesh());
        var quad = meshQuad4Point != null ? meshQuad4Point : (_genQuad = MakeQuadMesh());
        var scrap = meshScrap != null ? meshScrap : (_genScrap = MakeScrapMesh());
        var sphere = _genSphere = MakeSphereMesh();

        var list = new System.Collections.Generic.List<ParticleSystem>();

        if (enableSphereFlash)
            list.Add(MakeLayer(new LayerDef
            {
                name = "SphereFlash", mat = _matPlain, mesh = sphere,
                renderMode = ParticleSystemRenderMode.Mesh, alignment = ParticleSystemRenderSpace.Local,
                shape = ParticleSystemShapeType.Box, shapeScale = Vector3.zero,
                sizeMin = sphereFlashSize, sizeMax = sphereFlashSize,
                lifeMin = sphereFlashLifetime, lifeMax = sphereFlashLifetime,
                speedMin = 0f, speedMax = 0f, gravityMin = 0f, gravityMax = 0f,
                startColor = Color.white, grad = GradSphereFlash(), sizeCurve = C_Grow(),
                bursts = new[] { (0f, 1) }, sortOrder = 5,
                offset = new Vector3(0f, 0.68f, 0.18f), aimToCamera = true,
            }));

        if (enableSpikes)
            list.Add(MakeLayer(new LayerDef
            {
                name = "FlareSpikes", mat = _matFlare, mesh = cone,
                renderMode = ParticleSystemRenderMode.Mesh, alignment = ParticleSystemRenderSpace.Local,
                shape = ParticleSystemShapeType.Sphere, shapeRadius = spikeRadius,
                sizeMin = spikeSize, sizeMax = spikeSize,
                lifeMin = spikeLifetime, lifeMax = spikeLifetime,
                speedMin = 0f, speedMax = 0f, gravityMin = 0f, gravityMax = 0f,
                startColor = Color.white, grad = GradSpikes(), sizeCurve = C_Grow(),
                bursts = new[] { (0f, spikeCount) }, sortOrder = 3,
                offset = new Vector3(0f, -0.09f, 0.18f),
            }));

        if (enableDelayedSpikes)
            list.Add(MakeLayer(new LayerDef
            {
                name = "FlareSpikesDelayed", mat = _matFlare, mesh = cone,
                renderMode = ParticleSystemRenderMode.Mesh, alignment = ParticleSystemRenderSpace.Local,
                shape = ParticleSystemShapeType.Sphere, shapeRadius = delayedSpikeRadius,
                sizeMin = delayedSpikeSize, sizeMax = delayedSpikeSize,
                lifeMin = delayedSpikeLifetime, lifeMax = delayedSpikeLifetime,
                speedMin = 0f, speedMax = 0f, gravityMin = 0f, gravityMax = 0f,
                startColor = Color.white, grad = GradDelayed(), sizeCurve = C_DelayedSpike(),
                bursts = new[] { (delayedSpikeDelay, delayedSpikeCount) }, sortOrder = 3,
                offset = new Vector3(0f, -0.09f, 0.18f),
            }));

        if (enableInnerFire)
            list.Add(MakeLayer(new LayerDef
            {
                name = "InnerFire", mat = _matFire,
                renderMode = ParticleSystemRenderMode.Billboard, alignment = ParticleSystemRenderSpace.View,
                shape = ParticleSystemShapeType.Cone, shapeAngle = innerFireConeAngle, shapeRadius = innerFireConeRadius,
                sizeMin = innerFireSizeMin, sizeMax = innerFireSizeMax,
                lifeMin = innerFireLifeMin, lifeMax = innerFireLifeMax,
                speedMin = innerFireSpeedMin, speedMax = innerFireSpeedMax,
                gravityMin = innerFireGravity, gravityMax = innerFireGravity,
                startColor = new Color(0.612f, 0.612f, 0.612f, 1f),
                grad = GradInnerFire(), sizeCurve = C_InnerFire(),
                bursts = new[] { (0f, 4), (0.1f, 3), (0.2f, 2) }, sortOrder = 2,
                offset = new Vector3(0f, 0.19f, 0.18f), aimToCamera = true,
                clampVel = true, clampLimitMin = 1f, clampLimitMax = 1f, clampDampen = 0.1f,
                sheet = true, sheetTilesX = 2, sheetTilesY = 2,
                rotLife = true, rotLifeZMin = -1.5708f, rotLifeZMax = 1.5708f,
            }));

        if (enableFloaters)
            list.Add(MakeLayer(new LayerDef
            {
                name = "FireFloaters", mat = _matFire,
                renderMode = ParticleSystemRenderMode.Stretch, alignment = ParticleSystemRenderSpace.View,
                velocityScale = floaterVelocityScale, lengthScale = floaterLengthScale,
                shape = ParticleSystemShapeType.Hemisphere,
                shapeRadius = floaterShapeRadius, shapeAngle = floaterShapeAngle, radiusThickness = 0f,
                sizeMin = floaterSize, sizeMax = floaterSize,
                lifeMin = floaterLifeMin, lifeMax = floaterLifeMax,
                speedMin = floaterSpeedMin, speedMax = floaterSpeedMax,
                gravityMin = floaterGravityMin, gravityMax = floaterGravityMax,
                startColor = new Color(0.706f, 0.706f, 0.706f, 1f),
                grad = GradFloaters(), sizeCurve = C_Floaters(),
                bursts = new[] { (0f, 3), (0.05f, 3) }, sortOrder = 3,
                offset = new Vector3(0f, 0.602f, 0.18f), aimToCamera = true,
                noise = floaterNoise, noiseStrength = floaterNoiseStrength, noiseFrequency = floaterNoiseFrequency,
                clampVel = true, clampLimitMin = 0.5f, clampLimitMax = 2f, clampDampen = 0.1f,
                sheet = true, sheetTilesX = 2, sheetTilesY = 2,
                rotLife = true, rotLifeZMin = -3.14159f, rotLifeZMax = 3.14159f,
            }));

        if (enableDebris)
            list.Add(MakeLayer(new LayerDef
            {
                name = "FireyDebris", mat = _matFire, mesh = scrap,
                renderMode = ParticleSystemRenderMode.Mesh, alignment = ParticleSystemRenderSpace.Local,
                shape = ParticleSystemShapeType.Cone, shapeAngle = debrisConeAngle, shapeRadius = debrisConeRadius,
                randomDir = 1f, sphericalDir = 0.2f,
                sizeMin = debrisSizeMin, sizeMax = debrisSizeMax,
                lifeMin = debrisLifeMin, lifeMax = debrisLifeMax,
                speedMin = debrisSpeedMin, speedMax = debrisSpeedMax,
                gravityMin = debrisGravityMin, gravityMax = debrisGravityMax,
                startColor = Color.white, grad = GradDebris(), sizeCurve = C_Debris(),
                bursts = new[] { (0f, debrisCount) }, sortOrder = 0,
                offset = new Vector3(0f, 0.11f, 0f), aimToCamera = true,
                clampVel = true, clampLimitMin = 3f, clampLimitMax = 3f, clampDampen = 0.1f,
                rotLife = true, rotLifeZMin = 0f, rotLifeZMax = 6.283185f,
                collide = true, collideBounce = 1f, collideEnergyLoss = 0.5f,
            }));

        if (enableRing)
            list.Add(MakeLayer(new LayerDef
            {
                name = "GroundRing", mat = _matRing, mesh = quad,
                renderMode = ParticleSystemRenderMode.Mesh, alignment = ParticleSystemRenderSpace.Local,
                shape = ParticleSystemShapeType.Box, shapeScale = Vector3.zero,
                sizeMin = ringSize * ringSizeScale, sizeMax = ringSize * ringSizeScale,
                lifeMin = ringLifetime, lifeMax = ringLifetime,
                speedMin = 0f, speedMax = 0f, gravityMin = 0f, gravityMax = 0f,
                startColor = new Color(1f, 1f, 1f, 0.282f), grad = GradRing(), sizeCurve = C_Ring(),
                bursts = new[] { (0f, 1) }, sortOrder = 0,
                offset = new Vector3(0f, 0.13f, 0.18f),
            }));

        if (enableCircleSmoke)
            list.Add(MakeLayer(new LayerDef
            {
                name = "CircularSmoke", mat = _matSmoke,
                renderMode = ParticleSystemRenderMode.Billboard, alignment = ParticleSystemRenderSpace.View,
                shape = ParticleSystemShapeType.Cone, shapeAngle = circleSmokeConeAngle, shapeRadius = circleSmokeConeRadius,
                sizeMin = circleSmokeSizeMin, sizeMax = circleSmokeSizeMax,
                lifeMin = circleSmokeLifeMin, lifeMax = circleSmokeLifeMax,
                speedMin = circleSmokeSpeedMin, speedMax = circleSmokeSpeedMax,
                gravityMin = circleSmokeGravity, gravityMax = circleSmokeGravity,
                rotMin = -0.785f, rotMax = 0.785f,
                startColor = Color.white, grad = GradCircleSmoke(), sizeCurve = C_CircleSmoke(),
                bursts = new[] { (0f, circleSmokeCount) }, sortOrder = 2,
                offset = new Vector3(0f, 0.04f, 0.18f), aimToCamera = true,
                clampVel = true, clampLimitMin = 0.5f, clampLimitMax = 1.2f, clampDampen = 0.4f,
                rotLife = true, rotLifeZMin = -1.5708f, rotLifeZMax = 0.7854f,
            }));

        if (enableSmokeUp)
            list.Add(MakeLayer(new LayerDef
            {
                name = "SmokeUp", mat = _matSmoke,
                renderMode = ParticleSystemRenderMode.Billboard, alignment = ParticleSystemRenderSpace.View,
                shape = ParticleSystemShapeType.Cone, shapeAngle = smokeUpConeAngle, shapeRadius = smokeUpConeRadius,
                sizeMin = smokeUpSizeMin, sizeMax = smokeUpSizeMax,
                lifeMin = smokeUpLifeMin, lifeMax = smokeUpLifeMax,
                speedMin = smokeUpSpeedMin, speedMax = smokeUpSpeedMax,
                gravityMin = smokeUpGravityMin, gravityMax = smokeUpGravityMax,
                rotMin = -0.785f, rotMax = 0.785f,
                startColor = Color.white, grad = GradSmokeUp(), sizeCurve = C_SmokeUp(),
                bursts = new[] { (0f, smokeUpCount) }, sortOrder = 4,
                offset = new Vector3(0f, 0.13f, 0f) + smokeUpExtraOffset, aimToCamera = true,
                clampVel = true, clampLimitMin = 0.5f, clampLimitMax = 1.2f, clampDampen = 0.2f,
                rotLife = true, rotLifeZMin = -0.7854f, rotLifeZMax = 0.7854f,
            }));

        if (enableSmoke)
            list.Add(MakeLayer(new LayerDef
            {
                name = "Smoke", mat = _matSmoke,
                renderMode = ParticleSystemRenderMode.Billboard, alignment = ParticleSystemRenderSpace.View,
                shape = ParticleSystemShapeType.Sphere, shapeRadius = smokeRadius,
                sizeMin = smokeSize, sizeMax = smokeSize,
                lifeMin = smokeLifeMin, lifeMax = smokeLifeMax,
                speedMin = smokeSpeedMin, speedMax = smokeSpeedMax,
                gravityMin = smokeGravityMin, gravityMax = smokeGravityMax,
                rotMin = -0.785f, rotMax = 0.785f,
                startColor = Color.white, grad = GradSmoke(), sizeCurve = C_Smoke(),
                bursts = new[] { (smokeDelay, smokeCount) }, sortOrder = 2,
                offset = new Vector3(0f, 0.04f, 0f), aimToCamera = true,
                clampVel = true, clampLimitMin = 0.5f, clampLimitMax = 1.2f, clampDampen = 0.4f,
                rotLife = true, rotLifeZMin = -1.5708f, rotLifeZMax = 0.7854f,
            }));

        if (enableDecal)
        {
            list.Add(MakeLayer(new LayerDef
            {
                name = "DecalHeatedStrike", mat = _matDecal,
                renderMode = ParticleSystemRenderMode.HorizontalBillboard, alignment = ParticleSystemRenderSpace.View,
                shape = ParticleSystemShapeType.Sphere, shapeRadius = 0f,
                sizeMin = decalHeatedSize, sizeMax = decalHeatedSize,
                lifeMin = decalHeatedLifetime, lifeMax = decalHeatedLifetime,
                speedMin = 0f, speedMax = 0f, gravityMin = 0f, gravityMax = 0f,
                rotMin = 0f, rotMax = 6.283185f,                     // 参考：随机角度 → 每次爆炸底纹朝向不同
                startColor = Color.white, grad = GradDecalHeated(), sizeCurve = C_DecalHeated(),
                bursts = new[] { (0f, 1) }, sortOrder = 0,
                offset = new Vector3(0f, 0.05f, 0f),
            }));

            list.Add(MakeLayer(new LayerDef
            {
                name = "Decal", mat = _matDecal,
                renderMode = ParticleSystemRenderMode.HorizontalBillboard, alignment = ParticleSystemRenderSpace.View,
                shape = ParticleSystemShapeType.Sphere, shapeRadius = 0f,
                sizeMin = decalSize, sizeMax = decalSize,
                lifeMin = decalLifetime, lifeMax = decalLifetime,
                speedMin = 0f, speedMax = 0f, gravityMin = 0f, gravityMax = 0f,
                rotMin = 0f, rotMax = 6.283185f,
                startColor = new Color(0f, 0f, 0f, 0.541f), grad = GradDecal(), sizeCurve = null,
                bursts = new[] { (0f, 1) }, sortOrder = 0,
                offset = new Vector3(0f, 0.05f, 0f),
            }));
        }

        _all = list.ToArray();

        if (enableLight)
        {
            var lgo = new GameObject("ExplosionLight");
            lgo.transform.SetParent(transform, false);
            lgo.transform.localPosition = new Vector3(0.88f, explodeHeight + 0.73f, 0.15f);
            lgo.hideFlags = HideFlags.DontSave;
            _light = lgo.AddComponent<Light>();
            _light.type = LightType.Point;
            _light.color = lightColor;
            _light.range = lightRange * globalScale;
            _light.intensity = 0f;
            _light.shadows = LightShadows.None;
            lgo.SetActive(false);
        }

        ApplyAim();
        _built = true;
    }

    // ====================================================================
    // 喷射朝向
    // ====================================================================

    /// <summary>
    /// 把「出生形状的主轴(+Y)」转到目标方向。
    /// 参考 prefab 是固定的绕 X 轴 −90°（主轴 → 世界 −Z，正对参考 demo 的相机）。
    /// 在俯视锁视角游戏里，相机在头顶，若把主轴对准相机，烟/火会朝天喷射，变成一团垂直烟云；
    /// 而参考的 −90° 会让烟/火沿水平 −Z 方向burst，再靠负 gravityModifier 缓缓上升，才是「扩散→上升→消散」的正确节奏。
    /// 因此俯视场景默认用 aimMode=0（照搬参考），侧视/过场再用 aimMode=1 对准相机。
    /// ⛔ 只影响「出生方向 / 初速方向」，重力永远是 −Y（参考也是这样），所以瞄准后不需要补偿。
    /// </summary>
    private void ApplyAim()
    {
        if (_aimTargets.Count == 0) return;

        Quaternion q;
        if (aimMode == 0)
        {
            q = Quaternion.Euler(-90f, 0f, 0f);                     // 照搬参考
        }
        else if (aimMode == 2)
        {
            q = Quaternion.Euler(aimEulerOverride);                 // 自定义
        }
        else
        {
            var cam = Camera.main;
            if (cam == null)
            {
                q = Quaternion.Euler(-90f, 0f, 0f);                 // 没有主相机就退回参考朝向
            }
            else
            {
                // dir = 爆点 → 相机。LookRotation 让局部 +Z 对准 dir，
                // 再预乘 Rx(90°) 把局部 +Y 先掰到 +Z ⇒ 最终 +Y（出生主轴）指向相机。
                Vector3 dir = (cam.transform.position - transform.position);
                if (dir.sqrMagnitude < 1e-6f) dir = cam.transform.forward * -1f;
                dir.Normalize();
                // 相机几乎正上方时 LookRotation 的 up 会退化，换一个参考轴避免抖动
                Vector3 upRef = Mathf.Abs(Vector3.Dot(dir, Vector3.up)) > 0.98f ? Vector3.forward : Vector3.up;
                q = Quaternion.LookRotation(dir, upRef) * Quaternion.Euler(90f, 0f, 0f);
            }
        }

        for (int i = 0; i < _aimTargets.Count; i++)
            if (_aimTargets[i] != null) _aimTargets[i].rotation = q;
    }

    public void Explode() => ExplodeAt(transform.position);

    public void ExplodeAt(Vector3 worldPos)
    {
        if (!Application.isPlaying) return;
        Build();
        transform.position = worldPos;

        // 先瞄准再发射：已飞出去的粒子不受影响（World 模拟空间），所以每轮重新瞄一次即可
        ApplyAim();

        if (_all != null)
            for (int i = 0; i < _all.Length; i++) Trigger(_all[i]);

        if (_light != null)
        {
            _light.gameObject.SetActive(true);
            _light.intensity = lightIntensity;
            _lightT = 0f;
        }
    }

    private static void Trigger(ParticleSystem ps)
    {
        if (ps == null) return;
        ps.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
        ps.Play(true);
    }

    void Update()
    {
        if (_lightT >= 0f && _light != null)
        {
            _lightT += Time.deltaTime;
            float t = Mathf.Clamp01(_lightT / Mathf.Max(0.01f, lightDuration));
            _light.intensity = lightIntensity * (1f - t) * (1f - t);
            if (t >= 1f)
            {
                _light.intensity = 0f;
                _light.gameObject.SetActive(false);
                _lightT = -1f;
            }
        }

        if (loop && Application.isPlaying)
        {
            _loopTimer -= Time.deltaTime;
            if (_loopTimer <= 0f)
            {
                _loopTimer = Mathf.Max(0.2f, loopInterval);
                ExplodeAt(transform.position);
            }
        }
    }

    // ====================================================================
    // 层构建
    // ====================================================================

    private class LayerDef
    {
        public string name;
        public Material mat;
        public Mesh mesh;
        public ParticleSystemRenderMode renderMode = ParticleSystemRenderMode.Billboard;
        public ParticleSystemRenderSpace alignment = ParticleSystemRenderSpace.View;
        public ParticleSystemShapeType shape = ParticleSystemShapeType.Sphere;
        public float shapeAngle = 25f;
        public float shapeRadius = 1f;
        [Tooltip("1 = 形状内部实心分布；0 = 只在表面（参考给 fire_floaters 用的是 0）")]
        public float radiusThickness = 1f;
        public Vector3 shapeScale = Vector3.one;
        public float randomDir = 0f, sphericalDir = 0f;
        public float sizeMin = 1f, sizeMax = 1f;
        public float lifeMin = 1f, lifeMax = 1f;
        public float speedMin = 0f, speedMax = 0f;
        public float gravityMin = 0f, gravityMax = 0f;
        public float rotMin = 0f, rotMax = 0f;
        public Color startColor = Color.white;
        public Gradient grad;
        public AnimationCurve sizeCurve;
        public (float t, int n)[] bursts;
        public float velocityScale = 0f, lengthScale = 2f;
        public int sortOrder = 0;
        /// <summary>该层在参考 prefab 里的 localPosition（不再统一抬高，各层高低错开才有层次）。</summary>
        public Vector3 offset = Vector3.zero;
        /// <summary>true ⇒ 该层在参考里带 Rx(−90°)，其喷射主轴要交给 aimMode 控制。</summary>
        public bool aimToCamera = false;
        /// <summary>aimToCamera=false 的层所用的静态欧拉角（参考里就是 identity）。</summary>
        public Vector3 localEuler = Vector3.zero;
        public bool noise = false;
        public float noiseStrength = 1f, noiseFrequency = 0.5f;
        public int noiseOctaves = 1;
        public float noiseOctaveMultiplier = 0.5f;
        public bool noiseDamping = true;

        // ---- 参考 ClampVelocityModule（Unity6: limitVelocityOverLifetime）----
        /// <summary>true ⇒ 参考该层开了速度钳制。</summary>
        public bool clampVel = false;
        /// <summary>速度上限（随机区间）。粒子初速可以很高，但会被拉回这个上限。</summary>
        public float clampLimitMin = 1f, clampLimitMax = 1f;
        /// <summary>阻尼 0~1，越大拉回上限越猛。参考：烟 0.2~0.4、火 0.1。</summary>
        public float clampDampen = 0.1f;

        // ---- 参考 UVModule（Unity6: textureSheetAnimation）----
        /// <summary>true ⇒ 参考该层开了序列帧（fire.psd 是 2×2 精灵图）。</summary>
        public bool sheet = false;
        public int sheetTilesX = 2, sheetTilesY = 2;

        // ---- 参考 RotationModule（Unity6: rotationOverLifetime）----
        /// <summary>true ⇒ 参考该层开了生命周期内随机自转（弧度/秒，仅 Z 轴）。</summary>
        public bool rotLife = false;
        public float rotLifeZMin = 0f, rotLifeZMax = 0f;

        // ---- 参考 CollisionModule（仅 firey_debris 有）----
        /// <summary>true ⇒ 参考该层开了世界碰撞（碎片落地弹跳）。</summary>
        public bool collide = false;
        public float collideBounce = 1f, collideEnergyLoss = 0.5f;
    }

    private ParticleSystem MakeLayer(LayerDef d)
    {
        var go = new GameObject(d.name);
        go.transform.SetParent(transform, false);
        go.transform.localPosition = new Vector3(d.offset.x, explodeHeight + d.offset.y, d.offset.z);
        go.transform.localScale = Vector3.one * globalScale;
        if (d.aimToCamera && enableAim) _aimTargets.Add(go.transform);
        else go.transform.localRotation = Quaternion.Euler(d.localEuler);
        go.hideFlags = HideFlags.DontSave;

        var ps = go.AddComponent<ParticleSystem>();
        ps.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);

        var main = ps.main;
        main.loop = false;
        main.playOnAwake = false;
        main.simulationSpace = ParticleSystemSimulationSpace.World;
        main.startLifetime = Rnd(d.lifeMin, d.lifeMax);
        main.startSize = Rnd(d.sizeMin, d.sizeMax);
        main.startSpeed = Rnd(d.speedMin, d.speedMax);
        main.startColor = d.startColor;
        main.startRotation = Rnd(d.rotMin, d.rotMax);
        main.gravityModifier = Rnd(d.gravityMin, d.gravityMax);
        main.scalingMode = ParticleSystemScalingMode.Hierarchy;
        main.maxParticles = 256;

        float dur = d.lifeMax;
        if (d.bursts != null)
            for (int i = 0; i < d.bursts.Length; i++)
                dur = Mathf.Max(dur, d.bursts[i].t + d.lifeMax);
        main.duration = dur + 0.05f;

        if (d.bursts != null && d.bursts.Length > 0)
        {
            var arr = new ParticleSystem.Burst[d.bursts.Length];
            for (int i = 0; i < d.bursts.Length; i++)
                arr[i] = new ParticleSystem.Burst(d.bursts[i].t,
                    (short)d.bursts[i].n, (short)d.bursts[i].n);
            var em = ps.emission;
            em.enabled = true;
            em.rateOverTime = 0f;
            em.SetBursts(arr);
        }

        var sh = ps.shape;
        sh.enabled = true;
        sh.shapeType = d.shape;
        sh.radius = d.shapeRadius;
        sh.scale = d.shapeScale;
        sh.radiusThickness = d.radiusThickness;
        if (d.shape == ParticleSystemShapeType.Cone || d.shape == ParticleSystemShapeType.Hemisphere)
            sh.angle = d.shapeAngle;
        sh.randomDirectionAmount = d.randomDir;
        sh.sphericalDirectionAmount = d.sphericalDir;

        if (d.sizeCurve != null)
        {
            var sz = ps.sizeOverLifetime;
            sz.enabled = true;
            sz.size = new ParticleSystem.MinMaxCurve(1f, d.sizeCurve);
        }

        if (d.noise)
        {
            var nz = ps.noise;
            nz.enabled = true;
            nz.strength = d.noiseStrength;
            nz.frequency = d.noiseFrequency;
            nz.octaveCount = d.noiseOctaves;
            nz.octaveMultiplier = d.noiseOctaveMultiplier;
            nz.damping = d.noiseDamping;
            nz.quality = ParticleSystemNoiseQuality.High;   // 参考 quality=2
        }

        // ★ 速度钳制 + 阻尼：高初速爆出 → 被拉回低速 → 靠重力缓缓上飘（烟尘手感的灵魂）
        if (d.clampVel && enableClampVelocity)
        {
            var lv = ps.limitVelocityOverLifetime;
            lv.enabled = true;
            lv.separateAxes = false;                       // 参考未开分轴
            lv.limit = Rnd(d.clampLimitMin, d.clampLimitMax);
            lv.dampen = d.clampDampen;
        }

        // ★ 生命周期内随机自转（仅 Z 轴，单位弧度/秒）
        if (d.rotLife && enableRotOverLife)
        {
            var ro = ps.rotationOverLifetime;
            ro.enabled = true;
            ro.x = 0f;
            ro.y = 0f;
            ro.z = Rnd(d.rotLifeZMin, d.rotLifeZMax);
        }

        // ★ 序列帧：fire.psd 是 2×2 精灵图，每颗粒子随机取一格
        if (d.sheet && enableSheetAnimation)
        {
            var ts = ps.textureSheetAnimation;
            ts.enabled = true;
            ts.numTilesX = d.sheetTilesX;
            ts.numTilesY = d.sheetTilesY;
            ts.animation = ParticleSystemAnimationType.SingleRow;
            ts.useRandomRow = true;                        // 参考 randomRow=1
            ts.rowIndex = 0;
            ts.cycleCount = 1;                             // 参考 cycles=1
            ts.frameOverTime = new ParticleSystem.MinMaxCurve(0f, 1f);
            ts.startFrame = new ParticleSystem.MinMaxCurve(0f);
        }

        // ★ 世界碰撞：碎片落地弹跳（需要场景里有地面碰撞体）
        if (d.collide && enableDebrisCollision)
        {
            var cl = ps.collision;
            cl.enabled = true;
            cl.type = ParticleSystemCollisionType.World;
            cl.mode = ParticleSystemCollisionMode.Collision3D;
            cl.bounce = new ParticleSystem.MinMaxCurve(d.collideBounce);
            cl.energyLoss = new ParticleSystem.MinMaxCurve(d.collideEnergyLoss);
            cl.dampen = new ParticleSystem.MinMaxCurve(0f);
            cl.colliderForce = new ParticleSystem.MinMaxCurve(0f);
            cl.quality = ParticleSystemCollisionQuality.High;
        }

        if (d.grad != null)
        {
            var col = ps.colorOverLifetime;
            col.enabled = true;
            col.color = new ParticleSystem.MinMaxGradient(d.grad);
        }

        var r = ps.GetComponent<ParticleSystemRenderer>();
        r.sharedMaterial = d.mat;
        r.renderMode = d.renderMode;
        // Mesh 层的朝向模式走全局开关（参考老格式没这个字段，默认 Local 才有火舌的放射感）
        r.alignment = (d.renderMode == ParticleSystemRenderMode.Mesh) ? meshAlignment : d.alignment;
        r.sortingOrder = d.sortOrder;
        if (d.renderMode == ParticleSystemRenderMode.Mesh && d.mesh != null)
            r.mesh = d.mesh;
        if (d.renderMode == ParticleSystemRenderMode.Stretch)
        {
            r.velocityScale = d.velocityScale;
            r.lengthScale = d.lengthScale;
        }

        ps.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
        return ps;
    }

    private static ParticleSystem.MinMaxCurve Rnd(float a, float b)
        => Mathf.Approximately(a, b) ? new ParticleSystem.MinMaxCurve(a)
                                     : new ParticleSystem.MinMaxCurve(Mathf.Min(a, b), Mathf.Max(a, b));

    // ====================================================================
    // 材质
    // ====================================================================

    private Material MakeAdditive(Texture2D tex)
    {
        var sh = Shader.Find("MusicalSprite/BombVFXAdditive");
        if (sh == null)
        {
            Debug.LogWarning("[BombExplosion] 找不到 MusicalSprite/BombVFXAdditive，爆炸将显示为 magenta。");
            sh = Shader.Find("Hidden/InternalErrorShader");
        }
        var m = new Material(sh);
        m.hideFlags = HideFlags.DontSave;
        if (tex != null)
        {
            m.SetTexture("_BaseMap", tex);
            m.mainTexture = tex;
        }
        var w = Color.white * hdrIntensity;
        m.SetColor("_BaseColor", new Color(w.r, w.g, w.b, 1f));
        return m;
    }

    /// <summary>烟 / 焦痕专用 Alpha 混合（参考包 cartoonSmoke_mobile_alphaBlend / decal_alphaBlend）。</summary>
    private Material MakeAlpha(Texture2D tex)
    {
        var sh = Shader.Find("MusicalSprite/BombVFXAlpha");
        if (sh == null) sh = Shader.Find("Hidden/InternalErrorShader");
        var m = new Material(sh);
        m.hideFlags = HideFlags.DontSave;
        if (tex != null)
        {
            m.SetTexture("_BaseMap", tex);
            m.mainTexture = tex;
        }
        m.SetColor("_BaseColor", new Color(hdrIntensity, hdrIntensity, hdrIntensity, 1f));
        return m;
    }

    // ====================================================================
    // 程序化兜底素材
    // ====================================================================

    /// <summary>锥体：底在 y=0、尖朝 +Y、半径 0.25、高 0.37（对齐 cone.obj @ globalScale 0.01）。</summary>
    private static Mesh MakeConeMesh()
    {
        const int seg = 12;
        var verts = new System.Collections.Generic.List<Vector3>();
        var uvs = new System.Collections.Generic.List<Vector2>();
        var tris = new System.Collections.Generic.List<int>();
        verts.Add(new Vector3(0f, 0.37f, 0f)); uvs.Add(new Vector2(0.5f, 1f));   // apex
        for (int i = 0; i <= seg; i++)
        {
            float a = i * Mathf.PI * 2f / seg;
            float x = Mathf.Cos(a) * 0.25f, z = Mathf.Sin(a) * 0.25f;
            verts.Add(new Vector3(x, 0f, z));
            uvs.Add(new Vector2(i / (float)seg, 0f));
        }
        for (int i = 1; i < verts.Count - 1; i++)
        {
            tris.Add(0); tris.Add(i + 1); tris.Add(i);
        }
        return FinishMesh(verts, uvs, tris);
    }

    /// <summary>XZ 平面水平四边形（对齐 quad4point.obj @ globalScale 0.001）。</summary>
    private static Mesh MakeQuadMesh()
    {
        var verts = new System.Collections.Generic.List<Vector3>
        {
            new Vector3(-0.05f, 0f, 0.05f), new Vector3(0.05f, 0f, 0.05f),
            new Vector3(-0.05f, 0f, -0.05f), new Vector3(0.05f, 0f, -0.05f),
        };
        var uvs = new System.Collections.Generic.List<Vector2>
        {
            new Vector2(0f, 1f), new Vector2(1f, 1f), new Vector2(0f, 0f), new Vector2(1f, 0f),
        };
        var tris = new System.Collections.Generic.List<int> { 0, 1, 2, 2, 1, 3 };
        return FinishMesh(verts, uvs, tris);
    }

    /// <summary>不规则碎片（对齐 scrap.obj）。</summary>
    private static Mesh MakeScrapMesh()
    {
        var verts = new System.Collections.Generic.List<Vector3>
        {
            new Vector3(-0.054f, 0f, 0.041f), new Vector3(0.061f, 0f, 0.061f),
            new Vector3(0.022f, 0.073f, 0.032f), new Vector3(-0.041f, 0.031f, -0.033f),
        };
        var uvs = new System.Collections.Generic.List<Vector2>
        {
            new Vector2(0f, 0f), new Vector2(1f, 0f), new Vector2(1f, 1f), new Vector2(0f, 1f),
        };
        var tris = new System.Collections.Generic.List<int> { 0, 1, 2, 0, 2, 3, 0, 3, 1, 1, 3, 2 };
        return FinishMesh(verts, uvs, tris);
    }

    /// <summary>低模球（半径 0.5，对齐 Unity 内置 Sphere）。给 sphereFlash 用。</summary>
    private static Mesh MakeSphereMesh()
    {
        const int seg = 10, ring = 6;
        var verts = new System.Collections.Generic.List<Vector3>();
        var uvs = new System.Collections.Generic.List<Vector2>();
        var tris = new System.Collections.Generic.List<int>();
        for (int y = 0; y <= ring; y++)
        {
            float v = y / (float)ring;
            float phi = v * Mathf.PI;
            for (int x = 0; x <= seg; x++)
            {
                float u = x / (float)seg;
                float theta = u * Mathf.PI * 2f;
                float sy = Mathf.Cos(phi) * 0.5f;
                float sr = Mathf.Sin(phi) * 0.5f;
                verts.Add(new Vector3(Mathf.Cos(theta) * sr, sy, Mathf.Sin(theta) * sr));
                uvs.Add(new Vector2(u, 1f - v));
            }
        }
        int w = seg + 1;
        for (int y = 0; y < ring; y++)
            for (int x = 0; x < seg; x++)
            {
                int i = y * w + x;
                tris.Add(i); tris.Add(i + w); tris.Add(i + 1);
                tris.Add(i + 1); tris.Add(i + w); tris.Add(i + w + 1);
            }
        return FinishMesh(verts, uvs, tris);
    }

    private static Mesh FinishMesh(System.Collections.Generic.List<Vector3> v,
        System.Collections.Generic.List<Vector2> uv, System.Collections.Generic.List<int> tris)
    {
        var m = new Mesh { hideFlags = HideFlags.DontSave };
        m.SetVertices(v);
        m.SetUVs(0, uv);
        m.SetTriangles(tris, 0);
        m.RecalculateNormals();
        m.RecalculateBounds();
        return m;
    }

    // ---- 程序化贴图兜底 ----

    private static Texture2D MakeFireTexture()
    {
        const int n = 64;
        var t = new Texture2D(n, n, TextureFormat.RGBA32, false);
        float c = (n - 1) * 0.5f;
        for (int y = 0; y < n; y++)
            for (int x = 0; x < n; x++)
            {
                float dx = x - c, dy = y - c;
                float r = Mathf.Sqrt(dx * dx + dy * dy) / c;
                float a = Mathf.Pow(Mathf.Clamp01(1f - r), 1.3f);
                t.SetPixel(x, y, new Color(1f, 1f, 1f, a));
            }
        return FinishTex(t);
    }

    private static Texture2D MakeSmokeTexture()
    {
        const int n = 64;
        var t = new Texture2D(n, n, TextureFormat.RGBA32, false);
        float c = (n - 1) * 0.5f;
        for (int y = 0; y < n; y++)
            for (int x = 0; x < n; x++)
            {
                float dx = x - c, dy = y - c;
                float r = Mathf.Sqrt(dx * dx + dy * dy) / c;
                float falloff = 1f - Mathf.SmoothStep(0f, 1f, r);
                float n1 = Mathf.PerlinNoise(x * 0.06f + 10f, y * 0.06f + 20f);
                float a = Mathf.Pow(Mathf.Clamp01(falloff * (0.85f + (n1 - 0.5f) * 0.25f)), 2.0f);
                t.SetPixel(x, y, new Color(1f, 1f, 1f, a));
            }
        return FinishTex(t);
    }

    private static Texture2D MakeRingTexture()
    {
        const int n = 128;
        var t = new Texture2D(n, n, TextureFormat.RGBA32, false);
        float c = (n - 1) * 0.5f;
        for (int y = 0; y < n; y++)
            for (int x = 0; x < n; x++)
            {
                float dx = x - c, dy = y - c;
                float d = Mathf.Sqrt(dx * dx + dy * dy) / c;
                float band = Mathf.Exp(-((d - 0.78f) * (d - 0.78f)) / (2f * 0.13f * 0.13f));
                t.SetPixel(x, y, new Color(1f, 1f, 1f, Mathf.Clamp01(band)));
            }
        return FinishTex(t);
    }

    private static Texture2D MakeFlareTexture()
    {
        const int n = 64;
        var t = new Texture2D(n, n, TextureFormat.RGBA32, false);
        float c = (n - 1) * 0.5f;
        for (int y = 0; y < n; y++)
            for (int x = 0; x < n; x++)
            {
                float dx = x - c, dy = y - c;
                float r = Mathf.Sqrt(dx * dx + dy * dy) / c;
                float a = Mathf.Pow(Mathf.Clamp01(1f - r), 0.8f);
                t.SetPixel(x, y, new Color(1f, 1f, 1f, a));
            }
        return FinishTex(t);
    }

    private static Texture2D MakeDecalTexture()
    {
        const int n = 64;
        var t = new Texture2D(n, n, TextureFormat.RGBA32, false);
        float c = (n - 1) * 0.5f;
        for (int y = 0; y < n; y++)
            for (int x = 0; x < n; x++)
            {
                float dx = x - c, dy = y - c;
                float r = Mathf.Sqrt(dx * dx + dy * dy) / c;
                float n1 = Mathf.PerlinNoise(x * 0.11f, y * 0.11f);
                float a = Mathf.Clamp01((1f - r) * (0.5f + n1 * 0.8f));
                t.SetPixel(x, y, new Color(1f, 1f, 1f, a));
            }
        return FinishTex(t);
    }

    private static Texture2D FinishTex(Texture2D t)
    {
        t.hideFlags = HideFlags.DontSave;
        t.wrapMode = TextureWrapMode.Clamp;
        t.filterMode = FilterMode.Bilinear;
        t.anisoLevel = 1;
        t.Apply();
        return t;
    }
}
